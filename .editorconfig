# EditorConfig — 편집기 저장 규칙.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PowerShell: Windows PowerShell 5.1 은 BOM 이 없는 .ps1 을 시스템 ANSI 코드페이지(예: cp949)로
# 읽는다. 한글 주석·문자열이 깨지면서 구문 오류가 나므로 반드시 BOM 을 붙여 저장한다.
[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.{sh,bash}]
end_of_line = lf
indent_size = 2

[*.go]
indent_style = tab

[*.{yaml,yml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
