# 참고용 예시입니다. 이 프로그램은 .env 파일을 자동으로 읽지 않습니다.
# /api 없이 origin만 설정합니다. 실제 사용자 세션 토큰은 프로세스 환경으로 주입합니다.
ABLEOPS_BASE_URL=https://ableops.example.com
ABLEOPS_API_TOKEN=
# 한 도구의 전체 조회 시간과 개별 REST 요청의 상한입니다.
ABLEOPS_REQUEST_TIMEOUT=15s
ABLEOPS_CA_FILE=
MCP_LOG_LEVEL=info
# 선택 샘플 조회: 기본 비활성화, 활성화해도 partition/offset/timestamp만 공개합니다.
ABLEOPS_MESSAGE_SAMPLE_ENABLED=false
# 정확한 cluster_id/topic_name 조합을 쉼표로 구분합니다. 와일드카드 금지.
# ABLEOPS_MESSAGE_SAMPLE_TOPICS=synthetic-dev/orders
# 개발 중 loopback HTTP가 필요한 경우에만 true를 설정합니다.
ABLEOPS_ALLOW_HTTP=false
# HTTP 로컬 검증 모드: 공용 ABLEOPS_API_TOKEN은 읽지 않는다.
# 비밀 저장소는 공개 배포 파일과 분리하고 소유자만 읽고 쓸 수 있게 한다.
MCP_AUTH_STORE=
# OpenAPI 기반 Dynamic 도구(선택). true일 때만 /openapi.json을 읽고 주기적으로 갱신합니다.
ABLEOPS_DYNAMIC_TOOLS=false
# 선택할 operationId 쉼표 목록. 비우면 1차 파일럿 5개를 선택합니다.
# 노출 안전 게이트가 SAFE로 분류한 것만 추가됩니다(파일럿 5개는 모두 비노출).
ABLEOPS_DYNAMIC_OPERATIONS=
# 계약 변경 확인 주기. 비우면 5m, 허용 1m~24h.
ABLEOPS_DYNAMIC_REFRESH_INTERVAL=
